{
  // The following is needed to force vscode-powershell
  // to use the same settings as the editor config file.
  "editor.tabSize": 2,
  "[powershell]": {
    "files.encoding": "utf8bom",
  },
  "markdownlint.config": {
    "MD033": false,
  },
  "workbench.colorCustomizations": {
    // Chocolatey dark palette: https://design.chocolatey.org/foundations/colors
    "activityBar.background": "#141b1f",
    "activityBar.activeBorder": "#5c9fd8",
    "activityBar.foreground": "#e9ecef",
    "activityBar.inactiveForeground": "#e9ecefbf",
    "activityBarBadge.background": "#5c9fd8",
    "activityBarBadge.foreground": "#040c12",
    "titleBar.activeBackground": "#040c12",
    "titleBar.inactiveBackground": "#141b1f",
    "titleBar.activeForeground": "#e9ecef",
    "titleBar.inactiveForeground": "#e9ecefbf",
    "statusBar.background": "#254056",
    "statusBarItem.hoverBackground": "#375f82",
    "statusBar.foreground": "#e9ecef"
  },
  "cSpell.words": [
    "choco",
    "helperscripts",
    "INSTALLDIR",
    "isomount",
    "Kevenaar",
    "norestart",
    "PASSWORDCHG",
    "THIRDPARTY",
    "veeam",
    "VSPC"
  ]
}
